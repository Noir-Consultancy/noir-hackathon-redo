# Copy to .env and adjust. Never commit .env.

# --- LLM (any OpenAI-compatible endpoint, used via langchain-openai) ---
# Local Ollama on the host (default). Any chat model with tool calling works.
# qwen3.5:9b is quick to pull and run (`ollama pull qwen3.5:9b`). For playing for real,
# a larger model follows the mentor rules better, e.g. qwen3.6:27b or a cloud model below.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=ollama
# "none" turns off thinking in reasoning models (e.g. qwen3.5): ~2 s instead of ~20 s
# per reply. Leave empty to use the model's default.
LLM_REASONING_EFFORT=none
# Seconds per LLM request before giving up. Raise it for slow models on CPU.
LLM_TIMEOUT=60
# Address of host Ollama from inside the api container:
# Podman: http://host.containers.internal:11434/v1 · Docker: http://host.docker.internal:11434/v1
LLM_BASE_URL_CONTAINER=http://host.docker.internal:11434/v1

# Gemini via its OpenAI-compatible endpoint (free tier, key from https://aistudio.google.com):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_BASE_URL_CONTAINER=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=<your-key>

# --- Postgres (see compose.yaml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Must match the POSTGRES_* values above.
# From the host: localhost · from containers: postgres (set in compose.yaml)
DATABASE_URL=postgresql://app:app@localhost:5432/app

# --- World content (api) ---
# Defaults to <repo>/data/world when running locally; /data/world in the container.
# WORLD_DIR=
