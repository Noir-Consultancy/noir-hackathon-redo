# Copy to .env and adjust. Never commit .env.

# --- LLM (any OpenAI-compatible endpoint) ---
# Used by plain OpenAI clients. Agent frameworks and SDKs often read their own
# provider variables instead (e.g. OPENAI_API_KEY, GEMINI_API_KEY, OLLAMA_HOST) and
# often have native Gemini/Ollama support. Adjust these to what your framework expects.
# Local Ollama (default). From inside a container, use
# http://host.containers.internal:11434/v1 (Podman) or http://host.docker.internal:11434/v1 (Docker).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=ollama

# Embedding model for semantic search/RAG, served by the same endpoint (/v1/embeddings).
# bge-m3 is multilingual (incl. Swedish). Pull it with: ollama pull bge-m3
EMBEDDING_MODEL=bge-m3

# Gemini via its OpenAI-compatible endpoint (free tier, key from https://aistudio.google.com):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# EMBEDDING_MODEL=gemini-embedding-001
# LLM_API_KEY=<your-key>

# --- Kafka (see compose.yaml) ---
# From the host: localhost:9092 · from containers: kafka:19092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Postgres (see compose.yaml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Must match the POSTGRES_* values above.
# From the host: localhost · from containers: postgres
DATABASE_URL=postgresql://app:app@localhost:5432/app
