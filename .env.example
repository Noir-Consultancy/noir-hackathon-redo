# Copy to .env and adjust. Never commit .env.

# --- LLM (any OpenAI-compatible endpoint, used via langchain-openai) ---
# Local Ollama on the host (default). Use any chat model with tool calling that you
# have pulled, e.g. `ollama pull qwen3.6:27b-coding-mxfp8` or a smaller one.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.6:27b-coding-mxfp8
LLM_API_KEY=ollama
# Optional: "none" turns off thinking in reasoning models (e.g. qwen3), much faster on CPU.
# Leave empty to use the model's default.
LLM_REASONING_EFFORT=
# Address of host Ollama from inside the api container:
# Podman: http://host.containers.internal:11434/v1 · Docker: http://host.docker.internal:11434/v1
LLM_BASE_URL_CONTAINER=http://host.docker.internal:11434/v1

# Gemini via its OpenAI-compatible endpoint (free tier, key from https://aistudio.google.com):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_BASE_URL_CONTAINER=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=<your-key>

# --- Postgres (see compose.yaml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Must match the POSTGRES_* values above.
# From the host: localhost · from containers: postgres (set in compose.yaml)
DATABASE_URL=postgresql://app:app@localhost:5432/app

# --- World content (api) ---
# Defaults to <repo>/data/world when running locally; /data/world in the container.
# WORLD_DIR=
